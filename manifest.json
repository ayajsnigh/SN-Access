{
  "manifest_version": 3,
  "name": "ServiceNow Access Troubleshooter",
  "version": "1.1.0",
  "description": "Click the icon on any ServiceNow form or list to see which ACLs allow or block a user, and what would fix it.",
  "permissions": ["activeTab", "scripting"],
  "background": { "service_worker": "background.js" },
  "action": {
    "default_title": "Check ServiceNow access",
    "default_icon": { "16": "icon16.png", "32": "icon32.png", "48": "icon48.png" }
  },
  "icons": { "16": "icon16.png", "32": "icon32.png", "48": "icon48.png", "128": "icon128.png" }
}
